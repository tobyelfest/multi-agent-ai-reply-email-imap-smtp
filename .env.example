# Gmail account that receives customer messages.
EMAIL_ADDRESS=your-address@gmail.com

# Create this in Google Account > Security > 2-Step Verification > App passwords.
EMAIL_APP_PASSWORD=your-16-character-app-password

# Groq API credentials and model used by the existing LangGraph agents.
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=llama-3.3-70b-versatile

# Seconds to wait between inbox polls. Must be a positive integer.
CHECK_INTERVAL=30

# IMAP / SMTP settings (usually leave defaults for Gmail)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Log directory
LOG_DIR=logs

# Retry settings for LLM calls
LLM_RETRIES=3
RETRY_BASE_SECONDS=1

# Customisable relevance filtering (comma‑separated lists)
RELEVANCE_KEYWORDS=stok,ketersediaan,produk,barang,harga,beli,order,pemesanan,tersedia,ready,stock,availability,price,purchase,produk,persediaan
IGNORE_SENDERS=no-reply,noreply,mailer-daemon,postmaster,newsletter,notifications,alert,security,verification
IGNORE_DOMAINS=google.com,googlemail.com,accounts.google.com,amazon.com,paypal.com,facebook.com,instagram.com,twitter.com,x.com,shopify.com,mailchimp.com

# Fallback reply template (use \n for newlines)
FALLBACK_REPLY_TEMPLATE=Yth. Customer,\n\nTerima kasih atas email Anda.\n\nUntuk pertanyaan tentang stok, harga, atau pemesanan produk, silakan kirim email ke alamat ini.\nUntuk pertanyaan lain atau bantuan teknis, silakan hubungi tim support kami di support@perusahaan.com atau kunjungi website kami di https://www.perusahaan.com/help.\n\nKami siap membantu Anda.\n\nHormat kami,\nTim Customer Service

# File where processed message IDs are stored (atomic JSON)
PROCESSED_STORAGE_FILE=outputs/processed_emails.json
